{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Engine",
  "version": "1.0.0-release",
  "identifier": "dev.researchengine.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:3847",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/research-engine"
    ],
    "resources": {
      "../../frontend/dist": "frontend-dist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
