{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Engine",
  "version": "0.14.0-beta.1",
  "identifier": "dev.researchengine.desktop",
  "build": {
    "beforeDevCommand": "node ../backend/bin/research-engine.mjs serve --port 3847",
    "devUrl": "http://127.0.0.1:3847",
    "beforeBuildCommand": "npm run build --prefix ..",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Research Engine",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ]
  }
}
