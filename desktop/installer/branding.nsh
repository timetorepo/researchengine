; Original ResearchEngine presentation layer, loaded by Tauri's installerHooks.
; Deliberately keep Tauri's maintained install/upgrade/uninstall/WebView2 logic.
!define MUI_WELCOMEPAGE_TITLE "Make room for your next idea."
!define MUI_WELCOMEPAGE_TEXT "Welcome to ResearchEngine.$\r$\n$\r$\nA desktop workspace for research, writing and coding, with your library and settings stored on this device.$\r$\n$\r$\nConnect your preferred models or configure a local model after installation. Connected services have their own privacy terms.$\r$\n$\r$\nChoose Next to review the install location. WebView2 may be downloaded if it is missing."
!define MUI_FINISHPAGE_TITLE "Your workspace is ready."
!define MUI_FINISHPAGE_TEXT "ResearchEngine has been installed.$\r$\n$\r$\nOpen it to set up your workspace and model connections. Nothing is sent to an AI model until you choose to use it.$\r$\n$\r$\nYou can launch ResearchEngine now or find it in the Start menu later."
!define MUI_FINISHPAGE_RUN_TEXT "Open ResearchEngine"
!define MUI_FINISHPAGE_RUN_NOTCHECKED
!define MUI_FINISHPAGE_SHOWREADME_NOTCHECKED
; No shell commands, extra downloads, timers or user-data operations in hooks.
