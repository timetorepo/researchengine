{
  "name": "research-engine",
  "private": true,
  "version": "0.16.0-beta.1",
  "type": "module",
  "description": "A self-hosted, privacy-first research platform. Docker is optional \u2014 see README run modes.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "start": "node backend/bin/research-engine.mjs serve --port 3847",
    "start:eco": "RE_PROFILE=eco node backend/bin/research-engine.mjs serve --port 3847",
    "start:performance": "RE_PROFILE=performance node backend/bin/research-engine.mjs serve --port 3847",
    "smoke": "npm run smoke --workspace frontend",
    "desktop:dev": "npm run tauri:dev --prefix desktop",
    "desktop:build": "npm run tauri:build --prefix desktop",
    "package:binary": "node scripts/package-binary.mjs",
    "mobile:dev": "npm run dev --prefix mobile",
    "mobile:build": "npm run build --prefix mobile",
    "mobile:test": "npm test --prefix mobile",
    "tokens:gen": "node packages/tokens/generate.mjs",
    "tokens:test": "node --experimental-strip-types --no-warnings packages/tokens/test/tokens.test.mts",
    "prompts:sync": "node --experimental-strip-types --no-warnings packages/prompts/extract.mjs",
    "prompts:test": "node --experimental-strip-types --no-warnings packages/prompts/test/prompts.test.mts",
    "types:sync": "node --experimental-strip-types --no-warnings packages/types/extract.mjs",
    "types:test": "node --experimental-strip-types --no-warnings packages/types/test/types.test.mts",
    "test:port": "npm run tokens:test && npm run prompts:test && npm run types:test && npm run mobile:test"
  },
  "engines": {
    "node": ">=20"
  }
}