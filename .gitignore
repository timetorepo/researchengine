node_modules/
dist/
build/
release/
desktop/src-tauri/target/
*.db
*.db-wal
*.db-shm
.env
.DS_Store
.vite/

# Desktop sidecar binaries — 80 MB per platform, rebuilt by
# `node scripts/desktop-sidecar.mjs` (and by CI before bundling).
desktop/src-tauri/binaries/*
!desktop/src-tauri/binaries/README.txt
!desktop/src-tauri/binaries/.gitkeep

# The website: its own install, its own build output, and the untouched source
# images (the optimised WebP files under public/shots are what is committed).
website/node_modules/
website/dist/
website/.asset-src/

# Generated by website/scripts/prepare-assets.mjs on every build and dev run:
# the release manifest, and the portable archives copied out of downloads/.
website/public/release.json
website/public/downloads/
