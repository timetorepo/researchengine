# ---- Research Engine backend configuration ----
# All of these are optional. With none set, search falls back to demo mode
# and the frontend talks to providers directly (BYOK).

# Search backend: searxng | brave | serper | tavily | ddg | demo
SEARCH_BACKEND=searxng
SEARXNG_URL=http://localhost:8080

# Uncomment the key for the backend you choose
# BRAVE_API_KEY=
# SERPER_API_KEY=
# TAVILY_API_KEY=

# Local model discovery
OLLAMA_URL=http://localhost:11434

# Backend port
PORT=8787

# NOTE: Provider API keys (OpenAI, Anthropic, Groq…) are NOT configured here.
# They are entered in-app (Settings → Providers) and stay in your browser's
# encrypted local vault. That is the point of Research Engine.
