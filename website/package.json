{
  "name": "research-engine-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The public website for Research Engine: what it does, why it is free, and the download.",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --host 0.0.0.0",
